+
+void pvr_dr_rstate_cache_release(struct pvr_device *device,
+                                 struct pvr_render_state *rstate)
+{
+   simple_mtx_lock(&device->dr_rstate_cache_mtx);
+   assert(rstate->ref_count > 0);
+   rstate->ref_count--;
+   simple_mtx_unlock(&device->dr_rstate_cache_mtx);
