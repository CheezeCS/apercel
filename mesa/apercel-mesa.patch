+}
+
+void pvr_loadop_cache_release(struct pvr_loadop_cache_entry *entry)
+{
+   p_atomic_dec(&entry->ref_count);
+}
+
+void pvr_loadop_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->loadop_cache_mtx, mtx_plain);
+   device->loadop_cache =
+      _mesa_hash_table_create(NULL, pvr_loadop_key_hash, pvr_loadop_key_equal);
+   list_inithead(&device->loadop_lru);
+}
+
+void pvr_loadop_cache_fini(struct pvr_device *device)
+{
+   if (!device->loadop_cache)
+      return;
+
+   simple_mtx_lock(&device->loadop_cache_mtx);
+   list_for_each_entry_safe (struct pvr_loadop_cache_entry, entry,
+                             &device->loadop_lru, link) {
+      _mesa_hash_table_remove_key(device->loadop_cache, &entry->key);
+      pvr_loadop_entry_free(device, entry);
+   }
+   simple_mtx_unlock(&device->loadop_cache_mtx);
+
+   _mesa_hash_table_destroy(device->loadop_cache, NULL);
+   device->loadop_cache = NULL;
+   simple_mtx_destroy(&device->loadop_cache_mtx);
 }
 
