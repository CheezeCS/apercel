+      entry->ref_count++;
       list_del(&entry->link);
+      list_addtail(&entry->link, &device->loadop_lru);
+
+      pvr_loadop_cache_fill_programs(load_op, entry);
+
+      {
+         static int h_count;
+         if (getenv("PVR_LOADOP_DEBUG") && h_count < 8) {
+            h_count++;
