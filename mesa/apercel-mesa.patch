+struct pvr_dr_cache_entry {
+   struct pvr_dr_rstate_key key;
+   struct pvr_render_state *rstate;
+   struct list_head link;
+};
+
+#define PVR_DR_STATE_CACHE_MAX_ENTRIES 128
+
+static uint32_t pvr_dr_key_hash(const void *data)
+{
+   const uint32_t *p = data;
+   const size_t words = sizeof(struct pvr_dr_rstate_key) / sizeof(uint32_t);
+   uint32_t hash = 2166136261u;
+
+   for (size_t i = 0; i < words; i++) {
+      hash ^= p[i];
+      hash *= 16777619u;
+   }
+
+   return hash;
+}
+
+static bool pvr_dr_key_equal(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(struct pvr_dr_rstate_key)) == 0;
+}
+
+static void
+pvr_dr_rstate_cache_evict(struct pvr_device *device)
+{
+   while (device->dr_rstate_cache->entries > PVR_DR_STATE_CACHE_MAX_ENTRIES) {
+      struct pvr_dr_cache_entry *victim = NULL;
+
+      /* Evict the least recently used entry that has no other users. */
+      list_for_each_entry_safe (struct pvr_dr_cache_entry, entry,
+                                &device->dr_rstate_lru, link) {
+         if (entry->rstate->ref_count == 0) {
+            victim = entry;
+            break;
+         }
+      }
+
+      if (!victim)
+         break;
+
+      _mesa_hash_table_remove_key(device->dr_rstate_cache, &victim->key);
+      list_del(&victim->link);
+
+      pvr_render_state_cleanup(device, &device->vk.alloc, victim->rstate);
+      vk_free(&device->vk.alloc, victim->rstate);
+      vk_free(&device->vk.alloc, victim);
+   }
+}
+
+bool pvr_dr_rstate_cache_get_or_add(struct pvr_device *device,
+                                    const struct pvr_dr_rstate_key *key,
+                                    struct pvr_render_state *new_rstate,
+                                    struct pvr_render_state **out)
+{
+   struct hash_entry *he;
+
+   simple_mtx_lock(&device->dr_rstate_cache_mtx);
+
+   he = _mesa_hash_table_search(device->dr_rstate_cache, key);
+   if (he) {
+      struct pvr_dr_cache_entry *entry = he->data;
+
+      entry->rstate->ref_count++;
+      list_del(&entry->link);
+      list_addtail(&entry->link, &device->dr_rstate_lru);
+      *out = entry->rstate;
+
+      simple_mtx_unlock(&device->dr_rstate_cache_mtx);
+      return true;
+   }
+
+   /* First user: keep the caller's render state and insert it so that any
+    * concurrent lookup with the same key can share it while the hardware
+    * resources (datasets etc.) are still being set up lazily. */
