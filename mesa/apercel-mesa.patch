+   if (ret) {
+      return vk_errorf(device, VK_ERROR_MEMORY_MAP_FAILED,
+                       "dma-buf sync failed (errno %d: %s)", err, strerror(err));
+   }
+
+   return VK_SUCCESS;
+}
