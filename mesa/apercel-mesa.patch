+static void pvr_loadop_cache_evict(struct pvr_device *device)
+{
+   while (device->loadop_cache->entries > PVR_LOADOP_CACHE_MAX_ENTRIES) {
+      struct pvr_loadop_cache_entry *victim = NULL;
+
+      list_for_each_entry (struct pvr_loadop_cache_entry, entry,
+                           &device->loadop_lru, link) {
+         if (entry->ref_count == 0) {
+            victim = entry;
+            break;
+         }
+      }
+
+      if (!victim)
+         break;
+
+      _mesa_hash_table_remove_key(device->loadop_cache, &victim->key);
+      list_del(&victim->link);
+      pvr_loadop_entry_free(device, victim);
+   }
+}
