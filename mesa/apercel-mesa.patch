+
+void pvr_dr_rstate_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->dr_rstate_cache_mtx, mtx_plain);
+   device->dr_rstate_cache =
+      _mesa_hash_table_create(NULL, pvr_dr_key_hash, pvr_dr_key_equal);
+   list_inithead(&device->dr_rstate_lru);
+}
+
+void pvr_dr_rstate_cache_fini(struct pvr_device *device)
+{
+   simple_mtx_lock(&device->dr_rstate_cache_mtx);
+   list_for_each_entry_safe (struct pvr_dr_cache_entry, entry,
+                             &device->dr_rstate_lru, link) {
+      pvr_render_state_cleanup(device, &device->vk.alloc, entry->rstate);
+      vk_free(&device->vk.alloc, entry->rstate);
+      list_del(&entry->link);
+      vk_free(&device->vk.alloc, entry);
+   }
+   simple_mtx_unlock(&device->dr_rstate_cache_mtx);
+
+   if (device->dr_rstate_cache) {
+      _mesa_hash_table_destroy(device->dr_rstate_cache, NULL);
+      device->dr_rstate_cache = NULL;
