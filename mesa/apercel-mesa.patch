+      vk_alloc(&device->vk.alloc, sizeof(*entry), 8,
+               VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (entry) {
+      entry->key = *key;
+      entry->rstate = new_rstate;
+      list_inithead(&entry->link);
+      new_rstate->dr_cached = true;
+      new_rstate->ref_count = 1;
+      _mesa_hash_table_insert(device->dr_rstate_cache, &entry->key, entry);
+      list_addtail(&entry->link, &device->dr_rstate_lru);
+      pvr_dr_rstate_cache_evict(device);
+   }
+
+   simple_mtx_unlock(&device->dr_rstate_cache_mtx);
+   return false;
+}
+
+void pvr_dr_rstate_cache_remove(struct pvr_device *device,
+                                struct pvr_render_state *rstate)
+{
