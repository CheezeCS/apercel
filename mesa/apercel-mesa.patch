+static void pvr_loadop_debug_key(const struct pvr_loadop_key *key,
+                                 const char *evt)
+{
+   static FILE *dbg_file;
+   static struct pvr_loadop_key last_key;
+   static bool dbg_on = false;
+   static bool first = true;
+
+   if (first) {
+      dbg_on = getenv("PVR_LOADOP_DEBUG") != NULL;
+      first = false;
+   }
+   if (!dbg_on)
+      return;
+
+   if (!dbg_file)
+      dbg_file = stderr;
+
+   if (!strcmp(evt, "miss")) {
+      if (last_key.n_words == key->n_words &&
+          memcmp(&last_key, key, sizeof(*key)) == 0) {
+         fprintf(dbg_file, "LOADOP miss (identical to previous key), "
+                 "n_words=%u\n", key->n_words);
+      } else {
+         fprintf(dbg_file, "LOADOP miss n_words=%u\n", key->n_words);
+         if (last_key.n_words == key->n_words) {
+            for (uint32_t i = 0; i < key->n_words; i++) {
+               if (last_key.words[i] != key->words[i])
+                  fprintf(dbg_file,
+                          "  word[%u] differs: prev=0x%08x new=0x%08x\n",
+                          i, last_key.words[i], key->words[i]);
+            }
+         }
+      }
+      last_key = *key;
+   }
+}
