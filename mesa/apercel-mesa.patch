+
+/* ---------------------------------------------------------------------
+ * Dynamic-rendering / subpass load-op program cache.
+ *
+ * The load-op USC/PDS programs only depend on the value configuration of
+ * their render setup (attachment formats, clear/load masks, MRT setup,
+ * ...), which repeats from frame to frame. Caching them removes a large
+ * per-frame CPU cost (USC compile + PDS codegen + GPU uploads), since
+ * otherwise every CmdBeginRendering / every render pass recompiles them.
+ *
+ * Both pvr_arch_pass.c and pvr_arch_mrt.c feed their struct pvr_load_op
+ * through pvr_arch_load_op_shader_generate (cached) and must release
+ * cached entries via pvr_loadop_cache_release in their load-op fini.
+ * ---------------------------------------------------------------------
+ */
+
+#define PVR_LOADOP_CACHE_MAX_ENTRIES 128
+
+struct pvr_loadop_cache_entry {
+   struct pvr_loadop_key key;
+   struct pvr_suballoc_bo *usc_frag_prog_bo;
+   struct pvr_pds_upload pds_frag_prog;
+   struct pvr_pds_upload pds_tex_state_prog;
+   uint32_t temps_count;
+   /* Compile outputs of pvr_uscgen_loadop(): it rewrites these load_op
+    * fields, consumers (PDS background register packing) read them after
+    * generation. Cache hits must restore them. */
+   uint32_t num_tile_buffers;
+   uint32_t const_shareds_count;
+   uint32_t shareds_count;
+   int32_t ref_count;
+   struct list_head link;
+};
+
+static void pvr_loadop_key_fill(const struct pvr_load_op *load_op,
+                                struct pvr_loadop_key *key)
+{
+   const struct usc_mrt_setup *mrt_setup =
+      load_op->clears_loads_state.mrt_setup;
+   uint32_t *w = key->words;
+   uint32_t n = 0;
+
+   STATIC_ASSERT(sizeof(struct usc_mrt_resource) <=
+                 PVR_LOADOP_KEY_RESOURCE_DW * sizeof(uint32_t));
+   STATIC_ASSERT(PVR_LOAD_OP_CLEARS_LOADS_MAX_RTS == 16);
+
+   memset(key, 0, sizeof(*key));
+
+   w[n++] = load_op->is_hw_object;
+   w[n++] = load_op->num_tile_buffers;
+   w[n++] = load_op->const_shareds_count;
+   w[n++] = load_op->shareds_count;
+   w[n++] = load_op->clears_loads_state.rt_clear_mask |
+            ((uint32_t)load_op->clears_loads_state.rt_load_mask << 16);
+   w[n++] = load_op->clears_loads_state.rt_2d_view_3d_mask |
+            ((uint32_t)load_op->clears_loads_state.unresolved_msaa_mask
+               << 16);
+   w[n++] = (uint32_t)load_op->clears_loads_state.depth_clear_to_reg;
+
+   for (uint32_t i = 0; i < PVR_LOAD_OP_CLEARS_LOADS_MAX_RTS; i++)
+      w[n++] = (uint32_t)load_op->clears_loads_state.dest_vk_format[i];
+
+   w[n++] = load_op->view_count;
+   for (uint32_t i = 0; i < PVR_MAX_MULTIVIEW; i++)
+      w[n++] = load_op->view_indices[i];
+
+   w[n++] = mrt_setup->num_render_targets;
+   w[n++] = mrt_setup->num_output_regs;
+   w[n++] = mrt_setup->num_tile_buffers;
+   w[n++] = mrt_setup->disable_source_pos_override;
+
+   for (uint32_t i = 0;
+        i < MIN2(mrt_setup->num_render_targets, PVR_LOADOP_KEY_MAX_ATTS);
+        i++) {
+      memcpy(&w[n],
+             &mrt_setup->mrt_resources[i],
+             sizeof(struct usc_mrt_resource));
+      n += PVR_LOADOP_KEY_RESOURCE_DW;
+   }
+
+   key->n_words = n;
+}
+
+static uint32_t pvr_loadop_key_hash(const void *data)
+{
+   const struct pvr_loadop_key *key = data;
+   uint32_t hash = 2166136261u;
+
+   for (uint32_t i = 0; i < key->n_words; i++) {
+      hash ^= key->words[i];
+      hash *= 16777619u;
+   }
+
+   return hash;
+}
+
+static bool pvr_loadop_key_equal(const void *a, const void *b)
+{
+   const struct pvr_loadop_key *key_a = a;
+   const struct pvr_loadop_key *key_b = b;
+
+   if (key_a->n_words != key_b->n_words)
+      return false;
+
+   return memcmp(key_a->words,
+                 key_b->words,
+                 key_a->n_words * sizeof(key_a->words[0])) == 0;
+}
+
+static void pvr_loadop_entry_free(struct pvr_device *device,
+                                  struct pvr_loadop_cache_entry *entry)
+{
+   pvr_bo_suballoc_free(entry->usc_frag_prog_bo);
+   pvr_bo_suballoc_free(entry->pds_frag_prog.pvr_bo);
+   pvr_bo_suballoc_free(entry->pds_tex_state_prog.pvr_bo);
+   vk_free(&device->vk.alloc, entry);
+}
+
+static void pvr_loadop_cache_fill_programs(
+   struct pvr_load_op *load_op,
+   struct pvr_loadop_cache_entry *entry)
+{
+   load_op->usc_frag_prog_bo = entry->usc_frag_prog_bo;
+   load_op->pds_frag_prog = entry->pds_frag_prog;
+   load_op->pds_tex_state_prog = entry->pds_tex_state_prog;
